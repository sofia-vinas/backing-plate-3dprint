solid backing_plate
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 300 0
      vertex 400 300 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 400 300 0
      vertex 400 0 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 3.5
      vertex 400 0 3.5
      vertex 400 300 3.5
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 3.5
      vertex 400 300 3.5
      vertex 0 300 3.5
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 400 0 0
      vertex 400 0 3.5
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 400 0 3.5
      vertex 0 0 3.5
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 400 0 0
      vertex 400 300 0
      vertex 400 300 3.5
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 400 0 0
      vertex 400 300 3.5
      vertex 400 0 3.5
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 400 300 0
      vertex 0 300 0
      vertex 0 300 3.5
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 400 300 0
      vertex 0 300 3.5
      vertex 400 300 3.5
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 300 0
      vertex 0 0 0
      vertex 0 0 3.5
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 300 0
      vertex 0 0 3.5
      vertex 0 300 3.5
    endloop
  endfacet
endsolid backing_plate
